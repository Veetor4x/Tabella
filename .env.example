# Copy to .env and fill in yourself. Never commit real values. Testnet only.
QORE_CHAIN_ID=qorechain-diana
QORE_REST_URL=https://api-testnet.qore.host
QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# New testnet-only account, faucet-funded. Never a real wallet.
HELPER_MNEMONIC=
# The Postman's ML-KEM seed
POSTMAN_SEAL_SEED=

REGISTRY_ADDRESS=
POSTMAN_ADDRESS=

# Helper service (all optional, defaults shown; see helper/README.md)
# PORT=8787
# RATE_LIMIT_PER_MIN=10
# GLOBAL_RATE_LIMIT_PER_MIN=120
# TRUSTED_PROXY_HOPS=1        # 1 on Render, 0 locally
# CORS_ORIGINS=*              # set to the app's URL in production
# MAX_TX_GAS=12000000
# MAX_FEE_GWEI=250
# MIN_BALANCE_UQOR=2000000
# WINDOW_BLOCKS=17280
# WINDOW_MAX_TXS=200

# App (Vite)
VITE_HELPER_URL=
VITE_REGISTRY_ADDRESS=
VITE_POSTMAN_MLKEM_PUBKEY=
VITE_WALLETCONNECT_PROJECT_ID=
