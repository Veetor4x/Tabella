# Copy to .env and fill in yourself. Never commit real values. Testnet only.
QORE_CHAIN_ID=qorechain-diana
QORE_REST_URL=https://api-testnet.qore.host
QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# New testnet-only account, faucet-funded. Never a real wallet.
HELPER_MNEMONIC=
# (The Postman's ML-KEM key is derived from HELPER_MNEMONIC: no separate seed to store.)

REGISTRY_ADDRESS=
POSTMAN_ADDRESS=

# Helper service (all optional, defaults shown; see helper/README.md)
# PORT=8787
# RATE_LIMIT_PER_MIN=10
# GLOBAL_RATE_LIMIT_PER_MIN=120
# TRUSTED_PROXY_HOPS=1        # 1 on Render, 0 locally
# CORS_ORIGINS=*              # set to the app's URL in production
# MAX_TX_GAS=12000000
# MAX_FEE_GWEI=250
# MIN_BALANCE_UQOR=2000000
# WINDOW_BLOCKS=17280
# WINDOW_MAX_TXS=200
# FUND_ENABLED=true               # /fund: test coins for new opening cards (testnet only)
# FUND_AMOUNT_UQOR=400000
# FUND_PER_IP_PER_HOUR=3
# FUND_GLOBAL_PER_HOUR=40
# --- surprise letters: messages to the people a letter is for (add the keys on Render yourself)
# BREVO_API_KEY=                 # email through Brevo (no domain needed): used when set, otherwise Resend
# EMAIL_FROM=you@gmail.com       # a sender address verified in Brevo; the name shown is "Tabella"
# RESEND_API_KEY=                # email through Resend instead (needs a verified domain for other people's addresses)
# RESEND_FROM=Tabella <letters@your-verified-domain>
# --- later, behind the provider switch (texts and calls stay off until all three exist):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550100123
# TWILIO_VOICE_FROM=            # optional, defaults to TWILIO_FROM
# DATABASE_URL=                 # Postgres, so steps are never sent twice after a restart
# APP_URL=https://tabella-veetor4x.vercel.app
# POSTMAN_ENABLED=true
# POSTMAN_INTERVAL_SECONDS=20
# POSTMAN_HEIR_KEY_GRACE_MINUTES=30

# App (Vite). Both have working defaults in app/src/lib/config.ts (the Render helper and the current testnet registry).
VITE_HELPER_URL=
VITE_REGISTRY_ADDRESS=
VITE_POSTMAN_MLKEM_PUBKEY=
VITE_WALLETCONNECT_PROJECT_ID=
