{
  "name": "tabella-helper",
  "private": true,
  "type": "module",
  "description": "Tabella helper service: /relay (pays gas for TabellaRegistry calls) and, later, the Postman.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy-and-relay": "tsx --env-file-if-exists=.env scripts/deploy-and-relay.ts",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e-postman.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@hono/node-server": "^1.13.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoreseal": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "viem": "~2.53.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
